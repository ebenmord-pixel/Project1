# העתיקו קובץ זה ל-.env ומלאו את הערכים האמיתיים (הקובץ .env לא נשלח ל-GitHub)

# תיבת M365 / Outlook שממנה יישלחו תזכורות הקילומטראז' החודשיות
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=fleet-officer@yourcompany.com
SMTP_PASS=your-password-or-app-password
MAIL_FROM=fleet-officer@yourcompany.com

# כתובת האינטרנט שבה האפליקציה זמינה בפועל (חשוב לקישורי הדיווח שבתזכורות)
# בהרצה מקומית אפשר להשאיר את ברירת המחדל; בסביבת ייצור יש לעדכן לכתובת האמיתית
APP_BASE_URL=http://localhost:3000

# סוד להצפנת עוגיית ההתחברות - חובה לשנות לערך אקראי בסביבת ייצור
SESSION_SECRET=change-this-secret-in-production
