<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <%- include('partials/head', { title: 'מסך ראשי - קצין רכב' }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container wide">
    <div class="page-header">
      <h1>מסך ראשי</h1>
      <div class="header-actions">
        <a href="/employees/import" class="btn btn-secondary">ייבוא מאקסל</a>
        <a href="/employees/new" class="btn btn-primary">+ הוספת עובד</a>
      </div>
    </div>

    <section class="card">
      <h2>תזכורות מייל חודשיות</h2>
      <% if (mailConfigured) { %>
        <p class="empty-state">תזכורת אוטומטית נשלחת לכל עובד עם כתובת מייל מוגדרת, ב-1 לכל חודש בשעה 08:00 (כל עוד השרת רץ באותו הרגע). אפשר גם לשלוח ידנית עכשיו:</p>
        <form action="/reminders/send-now" method="POST" onsubmit="return confirm('לשלוח תזכורת מייל עכשיו לכל העובדים עם כתובת מייל מוגדרת?');">
          <button type="submit" class="btn btn-primary">שליחת תזכורות עכשיו</button>
        </form>
      <% } else { %>
        <p class="alert alert-error">שליחת מייל אוטומטית לא הוגדרה. יש להגדיר את משתני הסביבה SMTP_USER ו-SMTP_PASS (ראו README) כדי להפעיל תזכורות חודשיות.</p>
      <% } %>
    </section>

    <section class="card">
      <h2>פרטי עובדים ורכבים</h2>
      <% if (employees.length === 0) { %>
        <p class="empty-state">עדיין לא הוגדרו עובדים במערכת. לחצו על "הוספת עובד" כדי להתחיל.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>שם פרטי</th>
                <th>שם משפחה</th>
                <th>מספר רכב</th>
                <th>יצרן ודגם</th>
                <th>שנת ייצור</th>
                <th>תחילת חוזה ליסינג</th>
                <th>טלפון</th>
                <th>מייל</th>
                <th>שם משתמש</th>
                <th>שליחת קישור דיווח</th>
                <th>פעולות</th>
              </tr>
            </thead>
            <tbody>
              <% employees.forEach(emp => { %>
                <tr>
                  <td><%= emp.firstName %></td>
                  <td><%= emp.lastName %></td>
                  <td><%= emp.vehicleNumber %></td>
                  <td><%= [emp.manufacturer, emp.model].filter(Boolean).join(' - ') || '—' %></td>
                  <td><%= emp.year || '—' %></td>
                  <td><%= emp.leaseStartDate %></td>
                  <td><%= emp.phone || '—' %></td>
                  <td><%= emp.email || '—' %></td>
                  <td><%= emp.username %></td>
                  <td class="actions">
                    <% if (emp.waLink) { %>
                      <a href="<%= emp.waLink %>" target="_blank" rel="noopener" title="שליחה בוואטסאפ">📱 וואטסאפ</a>
                    <% } %>
                    <% if (emp.mailLink) { %>
                      <a href="<%= emp.mailLink %>" title="שליחה במייל">✉️ מייל</a>
                    <% } %>
                    <button type="button" class="link-btn copy-link-btn" data-link="<%= emp.reportUrl %>">העתקת קישור</button>
                    <form action="/employees/<%= emp.id %>/regenerate-token" method="POST" class="inline"
                          onsubmit="return confirm('איפוס הקישור יבטל את הקישור הישן שנשלח בעבר. להמשיך?');">
                      <button type="submit" class="link-btn">איפוס קישור</button>
                    </form>
                  </td>
                  <td class="actions">
                    <a href="/employees/<%= emp.id %>/reports">דיווחים</a>
                    <a href="/employees/<%= emp.id %>/edit">עריכה</a>
                    <form action="/employees/<%= emp.id %>/delete" method="POST" class="inline"
                          onsubmit="return confirm('למחוק את העובד <%= emp.firstName %> <%= emp.lastName %>?');">
                      <button type="submit" class="link-btn danger">מחיקה</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="card">
      <h2>דיווחי קילומטראז' אחרונים</h2>
      <% if (reports.length === 0) { %>
        <p class="empty-state">עדיין לא נשלחו דיווחים.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>עובד</th>
                <th>מספר רכב</th>
                <th>תאריך הדיווח</th>
                <th>קילומטראז'</th>
                <th>מועד שליחת הדיווח</th>
              </tr>
            </thead>
            <tbody>
              <% reports.forEach(r => { %>
                <tr>
                  <td><%= r.user ? (r.user.firstName + ' ' + r.user.lastName) : 'עובד שנמחק' %></td>
                  <td><%= r.vehicleNumber %></td>
                  <td><%= r.reportDate %></td>
                  <td><%= r.mileage.toLocaleString('he-IL') %> ק"מ</td>
                  <td><%= new Date(r.createdAt).toLocaleString('he-IL') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <script>
    document.querySelectorAll('.copy-link-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.link);
          const original = btn.textContent;
          btn.textContent = 'הועתק!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        } catch (e) {
          prompt('העתיקו את הקישור:', btn.dataset.link);
        }
      });
    });
  </script>
</body>
</html>
