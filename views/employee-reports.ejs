<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <%- include('partials/head', { title: 'דיווחים - ' + employee.firstName + ' ' + employee.lastName }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <div class="page-header">
      <h1>דיווחי קילומטראז' - <%= employee.firstName %> <%= employee.lastName %></h1>
      <a href="/dashboard" class="btn btn-secondary">חזרה למסך הראשי</a>
    </div>
    <section class="card">
      <p><strong>מספר רכב:</strong> <%= employee.vehicleNumber %> &nbsp;|&nbsp;
         <strong>תחילת חוזה ליסינג:</strong> <%= employee.leaseStartDate %></p>
    </section>

    <section class="card">
      <h2>עדכון קילומטראז' ידני</h2>
      <p class="empty-state">אם העובד דיווח לקצין הרכב את הקילומטראז' בדרך אחרת (טלפון, וואטסאפ וכו'), ניתן להזין אותו כאן ידנית.</p>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/employees/<%= employee.id %>/reports" class="form-row">
        <label>תאריך
          <input type="date" name="reportDate" value="<%= new Date().toISOString().slice(0,10) %>" required>
        </label>
        <label>קילומטראז'
          <input type="number" name="mileage" min="0" step="1" required>
        </label>
        <button type="submit" class="btn btn-primary">עדכון</button>
      </form>
    </section>

    <section class="card">
      <h2>היסטוריית דיווחים</h2>
      <% if (reports.length === 0) { %>
        <p class="empty-state">העובד עדיין לא שלח דיווחים.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>תאריך הדיווח</th>
                <th>קילומטראז'</th>
                <th>מועד שליחת הדיווח</th>
              </tr>
            </thead>
            <tbody>
              <% reports.forEach(r => { %>
                <tr>
                  <td><%= r.reportDate %></td>
                  <td><%= r.mileage.toLocaleString('he-IL') %> ק"מ</td>
                  <td><%= new Date(r.createdAt).toLocaleString('he-IL') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
